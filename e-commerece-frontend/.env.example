# Base URL of the backend API (must end with /api). Backend CORS must allow this site's origin.
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Public address of this website (used for canonical links and search-engine data)
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Shared secret the backend sends to ask this site to refresh cached pages.
# Must be identical to REVALIDATE_SECRET in the backend .env (min 32 characters).
REVALIDATE_SECRET="<same-secret-as-the-backend>"
