DATABASE_URL="postgresql://postgres:<password>@localhost:5432/ecommerce?schema=public"
PORT=3000
FRONTEND_URL="http://localhost:3001"
# development | production | test (production turns on secure cookies)
NODE_ENV=development

# Admin login. Generate a secret with: openssl rand -hex 32 (min 32 characters)
JWT_SECRET="<random-secret-at-least-32-chars>"
# How long an admin stays logged in, in days
ADMIN_SESSION_DAYS=7

# Owner account created by `npx prisma db seed` (password min 12 characters)
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="<choose-a-strong-password>"
SEED_ADMIN_NAME="Store Owner"

# Image uploads. "local" saves to UPLOADS_DIR and serves it at /uploads (development).
# "s3" works with AWS S3 and Cloudflare R2 (production).
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
# Public base URL for local uploads (default http://localhost:PORT/uploads)
UPLOADS_PUBLIC_URL="http://localhost:3000/uploads"
# Only needed when STORAGE_DRIVER=s3. For R2 set S3_REGION=auto and
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL images are served from (bucket URL, R2 public domain or CDN)
S3_PUBLIC_URL=

# Storefront cache refresh. The backend POSTs cache tags here after admin changes.
# Leave empty to disable. The secret must match the frontend (min 32 characters).
FRONTEND_REVALIDATE_URL=
REVALIDATE_SECRET="<random-secret-at-least-32-chars>"

# Customer accounts. Must be different from JWT_SECRET (admin), min 32 characters.
CUSTOMER_JWT_SECRET="<another-random-secret-at-least-32-chars>"
# How long a customer stays logged in, in days
CUSTOMER_SESSION_DAYS=30

# Email. "console" logs emails (with links) to the server log — development only.
# "provider" is the real email service, configured in phase 7.
MAIL_DRIVER=console
MAIL_FROM="Malikah Bridal Studio <hello@example.com>"

# Number of reverse proxies/load balancers in front of the API (0 locally,
# usually 1 in production). Needed so rate limits see the real client IP.
TRUST_PROXY=0

# Background jobs: release unpaid orders after 30 minutes (every 5 min) and
# delete carts inactive for 30 days (daily). Safe with several API servers.
SCHEDULER_ENABLED=true
